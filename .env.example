# Copy this file to .env and adjust for your environment.

# --- Database ---
# Production (PostgreSQL):
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/education_docs
# Local development (SQLite, no install required):
# DATABASE_URL=sqlite:///./education_docs.db

# --- OpenAI ---
# Required for AI field extraction. Leave blank to disable (docs then land in review queue).
OPENAI_API_KEY=

# --- Folder paths (relative paths resolve against the project root) ---
SCAN_FOLDER_PATH=./scans
SCAN_PROCESSED_PATH=./scans/_processed
SCAN_REVIEW_HOLD_PATH=./scans/_review_queue
STORAGE_PATH=./storage
STORAGE_REVIEW_PATH=./storage/review_queue

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- External tools (optional) ---
# Explicit paths to the Tesseract binary and Poppler bin dir. Leave blank to
# use PATH. Handy on Windows where PATH may not reach the server process.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\Users\<you>\AppData\Local\Microsoft\WinGet\Packages\oschwartz10612.Poppler_...\poppler-25.07.0\Library\bin
